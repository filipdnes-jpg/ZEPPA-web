{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(favicon.svg|favicon-32.png|apple-touch-icon.png|icon-512.png|og-image.jpg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
